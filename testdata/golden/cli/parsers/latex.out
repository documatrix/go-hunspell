line [$$ eqn $$ and \\begin{equation} ekw \\end{equation} done mistaek here]
token 10 [and] word [and]
token 50 [done] word [done]
token 55 [mistaek] word [mistaek]
change [$$ eqn $$ and \\begin{equation} ekw \\end{equation} done mistake here]
skip 1 [mistake]
token 63 [here] word [here]
line [\\begin{verbatim}]
line [verbatimm]
line [\\end{verbatim}]
line [\\verb|codde| \\verb+p+ \\verb#h# \\verb*s* x]
token 40 [x] word [x]
line [\\cite{knuth} \\ref{sec:a} \\label{l} \\cite[p.~3]{opt} after]
token 52 [after] word [after]
line [\\$ dollar \\% percent \\\\ break wrd]
token 3 [dollar] word [dollar]
token 13 [percent] word [percent]
token 24 [break] word [break]
token 30 [wrd] word [wrd]
change [\\$ dollar \\% percent \\\\ break word''s]
skip 1 [word]
line [``qoted'' it's don''t]
line [\\setlength{\\parindent}{0pt} after \\newcommand{\\foo}[1]{bar #1} x]
token 24 [pt] word [pt]
token 28 [after] word [after]
token 63 [x] word [x]
