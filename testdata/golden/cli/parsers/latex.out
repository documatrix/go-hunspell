token 34 [y] word [y]
token 44 [bold] word [bold]
line [\\\\[2mm] skip \\pagebreak[4] pb \\begin{tabular}{lcr} t]
token 8 [skip] word [skip]
token 27 [pb] word [pb]
token 51 [t] word [t]
