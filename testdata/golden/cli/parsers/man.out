utf8 0
line [.TH HUNSPELL 1 "2026"]
token 4 [HUNSPELL] word [HUNSPELL]
line [.SH NAME]
token 4 [NAME] word [NAME]
line [hunspell \\- spell checker]
token 0 [hunspell] word [hunspell]
token 12 [spell] word [spell]
token 18 [checker] word [checker]
line [\\fBhunspell\\fR [\\fIoptions\\fR] \\fBbolld\\fP]
token 3 [hunspell] word [hunspell]
token 19 [options] word [options]
token 34 [bolld] word [bolld]
line [.B boldd macro argument]
token 3 [boldd] word [boldd]
token 9 [macro] word [macro]
token 15 [argument] word [argument]
line [This is a manuall page.]
token 0 [This] word [This]
token 5 [is] word [is]
token 8 [a] word [a]
token 10 [manuall] word [manuall]
change [This is a manual page.]
skip 1 [manual]
token 17 [page] word [page]
line [.\\" comment line]
token 4 [comment] word [comment]
token 12 [line] word [line]
line [.]
line [trailing \\f]
token 0 [trailing] word [trailing]
token 10 [f] word [f]
prev 0 [trailing \\f]
prev 1 [.]
prev 2 [.\\" comment line]
prev 3 [This is a manual page.]
