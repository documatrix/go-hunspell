> fizar
  spell 0 0 
  sug fozar
> fozar
  spell 1 1 foo
@trace fizar
  trace 0 word "fizar"
  trace 1 lookup "fizar" -> miss
  trace 1 pfx "fizar" candidates=0
  trace 1 sfx "fizar" candidates=0
  trace 1 compound words=2
  trace 2 split at=1 left="f" right="izar"
  trace 3 first "f" -> miss
  trace 3 pfx "f" candidates=0
  trace 3 sfx "f" candidates=0
  trace 2 split at=2 left="fi" right="zar"
  trace 3 first "fi" -> miss
  trace 3 pfx "fi" candidates=0
  trace 3 sfx "fi" candidates=0
  trace 2 split at=3 left="fio" right="bar" cpdpattern=1
  trace 3 first "fio" -> entry "fio" flags=F,X
  trace 2 split at=3 left="fiz" right="ar"
  trace 3 first "fiz" -> miss
  trace 3 pfx "fiz" candidates=0
  trace 3 sfx "fiz" candidates=0
