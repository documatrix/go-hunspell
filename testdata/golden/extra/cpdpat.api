  trace 3 first "fiza" -> miss
  trace 3 pfx "fiza" candidates=0
  trace 3 sfx "fiza" candidates=0
  trace 1 compound words=3+
  trace 2 split at=1 left="f" right="izar"
  trace 3 first "f" -> miss
  trace 3 pfx "f" candidates=0
  trace 3 sfx "f" candidates=0
  trace 2 split at=2 left="fi" right="zar"
