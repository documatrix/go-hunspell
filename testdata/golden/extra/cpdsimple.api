# example: 
> aabbcc
  spell 0 0 
  sug AABBCC
  ana  pa:aa st:aa pa:bb st:bb pa:cc
  stem aabb
  stemmorph aabb
> aabbcz
  spell 0 0 
  sug aabbcy
  ana  pa:aa st:aa pa:bb st:bb pa:cz
  stem aabb
  stemmorph aabb
> aabbaa
  spell 1 1 aa
  sug aabbaa
  sug aabbcy
  ana  pa:aa st:aa pa:bb st:bb pa:aa
  stem aabb
  stemmorph aabb
> AABBCC
  spell 1 32 
  sug AABBCC
  ana  st:AABBCC
  ana  pa:aa st:aa pa:bb st:bb pa:cc
  stem AABBCC
  stem aabb
  stemmorph AABBCC
  stemmorph aabb
