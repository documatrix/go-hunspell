@trace almaház
  trace 0 word "almaház"
  trace 1 lookup "almaház" -> miss
  trace 1 pfx "almaház" candidates=0
  trace 1 sfx "almaház" candidates=0
  trace 1 compound words=2
  trace 2 split at=3 left="alm" right="aház"
  trace 3 first "alm" -> miss
  trace 3 pfx "alm" candidates=0
  trace 3 sfx "alm" candidates=0
  trace 3 sfx "alm" candidates=0
  trace 3 pfx "alm" candidates=0
  trace 2 split at=4 left="alma" right="ház"
  trace 3 first "alma" -> entry "alma" flags=I,J,K,P,Q,X,c
  trace 3 second "ház" -> entry "ház" flags=I,J,L,X,c
  trace 3 test wordpair -> pass, no space splits this into a known word pair
  trace 1 result correct
  spell 1
