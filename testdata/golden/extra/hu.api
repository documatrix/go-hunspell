@trace láb
  trace 0 word "láb"
  trace 1 lookup "láb" -> entry "láb" flags=O,P,X,c
  trace 1 test onlyincompound flag=O in=dic have=O,P,X,c -> fail, on to the next homonym
  trace 1 lookup "láb" -> no more homonyms
  trace 1 pfx "láb" candidates=0
  trace 1 sfx "láb" candidates=0
  trace 1 compound words=2
  trace 1 compound words=3+
  trace 1 result incorrect
  spell 0
@trace lábnak
  trace 0 word "lábnak"
  trace 1 lookup "lábnak" -> miss
  trace 1 pfx "lábnak" candidates=0
  trace 1 sfx flag=c strip="" add="nak" cont=(none) cond="." at=aff:32 xprod=Y hdr=aff:31
  trace 2 stem "láb"
