# example: foos
> foo
  spell 1 0 
  sug foo
  ana  st:foo
  stem foo
  stemmorph foo
  sfx fooer
  sfx foos
  gen foos
  genmorph foos
> foos
  spell 1 0 foo
  sug foos
  sug foo
  ana  st:foo is:
  stem foo
  stemmorph foo
  gen foos
  genmorph foos
@gen foo is:
  gen foos
@gen foo is:x
  gen fooer
